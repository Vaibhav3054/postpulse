# ==============================================================================
# PostPulse SaaS — Complete Environment Variables Configuration (.env.example)
# ==============================================================================
# Copy this file to `.env` for local development, or add these keys inside
# Netlify Site Settings -> Environment Variables (with Functions scope enabled).
# NEVER commit real secrets to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Application
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
APP_URL=https://postpulse-saas.netlify.app

# ------------------------------------------------------------------------------
# 2. Cryptographic & Security Secrets (Generate with: openssl rand -hex 32)
# ------------------------------------------------------------------------------
# Minimum 32 characters (64 hex chars recommended)
JWT_SECRET=replace_with_a_long_random_jwt_secret_key_minimum_32_characters
# Optional separate secret for /platform-admin sessions (defaults to JWT_SECRET + domain salt if omitted)
ADMIN_JWT_SECRET=replace_with_a_separate_64_hex_super_admin_jwt_secret
# MUST be exactly 64 hexadecimal characters (32 bytes) for AES-256-GCM OAuth token encryption
TOKEN_ENCRYPTION_SECRET=replace_with_64_hex_characters_generated_via_openssl_rand_hex_32
# Shared secret used by Netlify Scheduled & Background Functions to trigger /api/publishing/dispatch
CRON_SECRET=replace_with_a_secure_random_cron_secret_token

# Optional comma-separated Super Admin email allowlist (extra guard on /platform-admin)
SUPERADMIN_EMAILS=founder@yourdomain.com

# ------------------------------------------------------------------------------
# 3. Supabase PostgreSQL Database (Prisma ORM)
# ------------------------------------------------------------------------------
# Transaction Pooler URL (port 6543, required for Netlify serverless runtime)
DATABASE_URL="postgresql://postgres.[PROJECT_ID]:[PASSWORD]@aws-1-ap-southeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct Connection URL (port 5432, used for Prisma schema migrations)
DIRECT_URL="postgresql://postgres.[PROJECT_ID]:[PASSWORD]@aws-1-ap-southeast-2.pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# 4. Supabase Cloud Object Storage (Required in Production)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://[PROJECT_ID].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret
STORAGE_BUCKET=postpulse-assets

# ------------------------------------------------------------------------------
# 5. Transactional Email Delivery (Resend — Free up to 3,000 emails/month)
# ------------------------------------------------------------------------------
# Used for team invitations, password reset links, and failed publishing alerts.
# When omitted, in-app notifications and copyable invite links still work cleanly.
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM="PostPulse <notifications@postpulse.io>"

# ------------------------------------------------------------------------------
# 6. Social Provider Mode
# ------------------------------------------------------------------------------
# Set to "true" for sandbox/mock testing without live third-party developer apps.
# Set to "false" once Google, Meta, and LinkedIn OAuth credentials below are live.
MOCK_SOCIAL_PROVIDERS=true

# ------------------------------------------------------------------------------
# 7. Google Cloud OAuth (Google Business Profile & YouTube Data API v3)
# ------------------------------------------------------------------------------
# Authorized Redirect URI in Google Cloud Console:
#   https://postpulse-saas.netlify.app/api/auth/callback/google
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_OAUTH_REDIRECT_URI=https://postpulse-saas.netlify.app/api/auth/callback/google

# ------------------------------------------------------------------------------
# 8. Meta Developer App (Facebook Pages & Instagram Professional Graph API v20.0)
# ------------------------------------------------------------------------------
# Valid OAuth Redirect URI in Meta App Dashboard:
#   https://postpulse-saas.netlify.app/api/auth/callback/meta
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_OAUTH_REDIRECT_URI=https://postpulse-saas.netlify.app/api/auth/callback/meta

# ------------------------------------------------------------------------------
# 9. LinkedIn Developer Platform (Share & Organization Pages API)
# ------------------------------------------------------------------------------
# Authorized Redirect URL in LinkedIn Developer Portal:
#   https://postpulse-saas.netlify.app/api/auth/callback/linkedin
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_OAUTH_REDIRECT_URI=https://postpulse-saas.netlify.app/api/auth/callback/linkedin
# Set to "true" once LinkedIn approves Community Management / Organization Page scopes
LINKEDIN_ENABLE_ORG_SCOPES=false

# ------------------------------------------------------------------------------
# 10. Razorpay Subscriptions & Billing (Test Mode -> Live Mode)
# ------------------------------------------------------------------------------
# Public Key ID (safe to expose to Razorpay Checkout modal on frontend)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
# Server-side Key ID & Key Secret (NEVER expose secret to browser)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Webhook signing secret configured at: https://postpulse-saas.netlify.app/api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Razorpay Plan IDs (created in Razorpay Dashboard -> Subscriptions -> Plans)
RAZORPAY_PLAN_PRO_MONTHLY=plan_your_pro_monthly_id
RAZORPAY_PLAN_PRO_ANNUAL=plan_your_pro_annual_id
RAZORPAY_PLAN_AGENCY_MONTHLY=plan_your_agency_monthly_id
RAZORPAY_PLAN_AGENCY_ANNUAL=plan_your_agency_annual_id

# ------------------------------------------------------------------------------
# 11. Error Monitoring & Operational Alerting (Optional)
# ------------------------------------------------------------------------------
# Optional Sentry DSN for server exception forwarding (lightweight envelope API)
SENTRY_DSN=
# Optional Slack / Discord / PagerDuty incoming webhook URL for critical errors
ALERT_WEBHOOK_URL=
