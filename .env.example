# ==============================================================================
# PostPulse — Environment Variables Configuration
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Authentication & Encryption Secrets
JWT_SECRET=replace_with_a_long_random_jwt_secret_key_minimum_32_characters
TOKEN_ENCRYPTION_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef # 64 hex characters (32 bytes)

# PostgreSQL Database (e.g. Supabase, Neon, or local PostgreSQL)
DATABASE_URL="postgresql://postgres.[PROJECT_ID]:[PASSWORD]@aws-1-ap-southeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT_ID]:[PASSWORD]@aws-1-ap-southeast-2.pooler.supabase.com:5432/postgres"

# Supabase Storage Configuration (Zero Card Required Free Object Storage)
SUPABASE_URL=https://[PROJECT_ID].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret
STORAGE_BUCKET=postpulse-assets

# Cloudflare R2 / S3-Compatible Media Storage (Optional Alternative)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=postpulse-assets
R2_PUBLIC_DOMAIN=https://assets.yourdomain.com

# Cron Dispatcher Secret (for vercel / external cron runner)
CRON_SECRET=replace_with_a_secure_random_cron_secret_token

# Redis / BullMQ Queues (e.g. Upstash Redis or local Redis)
REDIS_URL=redis://localhost:6379

# Social Provider Mode (set to 'true' for local testing without approved live apps)
MOCK_SOCIAL_PROVIDERS=true

# Meta Developer App (Instagram Graph API & Facebook Pages API)
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/callback/meta

# Google Cloud Console (YouTube Data API v3)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/callback/google

# LinkedIn Developer Platform (Community Management & Share API)
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/callback/linkedin
