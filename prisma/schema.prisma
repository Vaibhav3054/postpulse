datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum SystemRole {
  USER
  SUPERADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum SocialPlatform {
  INSTAGRAM
  FACEBOOK
  YOUTUBE
  LINKEDIN
  GOOGLE_BUSINESS
}

enum MediaType {
  IMAGE
  VIDEO
}

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHING
  PUBLISHED
  PARTIALLY_PUBLISHED
  FAILED
}

enum TargetPublishStatus {
  PENDING
  PUBLISHING
  PUBLISHED
  FAILED
}

enum NotificationType {
  PUBLISH_FAILED
  TOKEN_EXPIRED
  ACCOUNT_DISCONNECTED
  PUBLISH_SUCCESS
  SYSTEM
}

enum BillingInterval {
  MONTHLY
  ANNUAL
  NONE
}

enum SubscriptionSource {
  FREE
  PAID
  COMPLIMENTARY
}

enum SubscriptionStatus {
  CREATED
  AUTHENTICATED
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
  REVOKED
}

enum PaymentStatus {
  PENDING
  CAPTURED
  FAILED
  REFUNDED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  REVOKED
  EXPIRED
}

model User {
  id              String            @id @default(uuid())
  email           String            @unique
  passwordHash    String
  fullName        String?
  avatarUrl       String?
  systemRole      SystemRole        @default(USER)
  status          UserStatus        @default(ACTIVE)
  tokenVersion    Int               @default(0)
  emailVerified   Boolean           @default(false)
  workspaces      WorkspaceMember[]
  ownedWorkspaces Workspace[]       @relation("WorkspaceOwner")
  createdPosts        Post[]
  activityLogs        ActivityLog[]
  notifications       Notification[]
  subscriptions       Subscription[]
  paymentTransactions PaymentTransaction[]
  sentInvitations     WorkspaceInvitation[] @relation("SentWorkspaceInvitations")
  createdAt           DateTime              @default(now())
  updatedAt       DateTime          @updatedAt
}

model SubscriptionPlan {
  id                        String         @id @default(uuid())
  name                      String
  code                      String         @unique // 'free', 'pro', 'agency'
  maxWorkspaces             Int            @default(1)
  maxSocialAccounts         Int            @default(3)
  maxScheduledPostsPerMonth Int            @default(30)
  maxStorageMb              Int            @default(500)
  maxTeamMembers            Int            @default(1)
  priceCents                Int            @default(0)
  priceMonthlyInr           Int            @default(0)
  priceAnnualInr            Int            @default(0)
  razorpayPlanIdMonthly     String?
  razorpayPlanIdAnnual      String?
  features                  Json           @default("[]")
  isActive                  Boolean        @default(true)
  workspaces                Workspace[]
  subscriptions             Subscription[]
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @default(now()) @updatedAt
}

model Workspace {
  id             String            @id @default(uuid())
  name           String
  slug           String            @unique
  logoUrl        String?
  ownerId        String
  owner          User              @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  planId         String
  plan           SubscriptionPlan  @relation(fields: [planId], references: [id])
  members        WorkspaceMember[]
  socialAccounts SocialAccount[]
  mediaAssets    MediaAsset[]
  posts          Post[]
  activityLogs   ActivityLog[]
  notifications  Notification[]
  invitations    WorkspaceInvitation[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([slug])
}

model WorkspaceMember {
  id          String        @id @default(uuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt    DateTime      @default(now())

  @@unique([workspaceId, userId])
  @@index([userId])
}

model SocialAccount {
  id                    String                @id @default(uuid())
  workspaceId           String
  platform              SocialPlatform
  platformAccountId     String
  platformUsername      String?
  platformDisplayName   String?
  avatarUrl             String?
  accessTokenEncrypted  String
  refreshTokenEncrypted String?
  tokenExpiresAt        DateTime?
  scopes                String[]              @default([])
  metadata              Json                  @default("{}")
  isActive              Boolean               @default(true)
  workspace             Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  targets               PostPlatformTarget[]
  businessProfile       BusinessProfileLocation?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@unique([workspaceId, platform, platformAccountId])
  @@index([workspaceId, platform])
}

model MediaAsset {
  id              String      @id @default(uuid())
  workspaceId     String
  fileName        String
  storageKey      String      @unique
  publicUrl       String
  mediaType       MediaType
  mimeType        String
  fileSizeBytes   BigInt
  width           Int?
  height          Int?
  durationSeconds Int?
  isTemporary     Boolean     @default(false)
  workspace       Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  posts           PostMedia[]
  createdAt       DateTime    @default(now())

  @@index([workspaceId])
}

model Post {
  id              String               @id @default(uuid())
  workspaceId     String
  createdByUserId String?
  status          PostStatus           @default(DRAFT)
  commonCaption   String?              @db.Text
  scheduledAt     DateTime?
  timezone        String               @default("UTC")
  publishedAt     DateTime?
  workspace       Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdByUser   User?                @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  media           PostMedia[]
  platformTargets PostPlatformTarget[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([workspaceId, status])
  @@index([status, scheduledAt])
}

model PostMedia {
  postId       String
  mediaAssetId String
  displayOrder Int        @default(0)
  post         Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  mediaAsset   MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@id([postId, mediaAssetId])
}

model PostPlatformTarget {
  id              String               @id @default(uuid())
  postId          String
  socialAccountId String
  platform        SocialPlatform
  customCaption   String?              @db.Text
  platformPayload Json                 @default("{}")
  status          TargetPublishStatus  @default(PENDING)
  externalPostId  String?
  externalPostUrl String?
  errorMessage    String?
  errorDetails    Json?
  publishedAt     DateTime?
  idempotencyKey  String               @unique
  retryCount      Int                  @default(0)
  maxRetries      Int                  @default(3)
  nextRetryAt     DateTime?
  lockedAt        DateTime?
  lockOwner       String?
  isMockPublish   Boolean              @default(false)

  // Performance & Insights Metrics
  impressions     Int                  @default(0)
  likes           Int                  @default(0)
  comments        Int                  @default(0)
  shares          Int                  @default(0)
  reach           Int                  @default(0)
  clicks          Int                  @default(0)
  metricsUpdatedAt DateTime?

  post            Post                 @relation(fields: [postId], references: [id], onDelete: Cascade)
  socialAccount   SocialAccount        @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  publishAttempts PublishAttempt[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([postId])
  @@index([socialAccountId])
  @@index([status, nextRetryAt])
  @@index([lockedAt])
}

model PublishAttempt {
  id                   String              @id @default(uuid())
  postPlatformTargetId String
  attemptNumber        Int                 @default(1)
  status               TargetPublishStatus
  requestSummary       Json?
  responseSummary      Json?
  errorCode            String?
  errorMessage         String?
  executedAt           DateTime            @default(now())
  durationMs           Int?
  target               PostPlatformTarget  @relation(fields: [postPlatformTargetId], references: [id], onDelete: Cascade)

  @@index([postPlatformTargetId])
}

model ActivityLog {
  id          String    @id @default(uuid())
  workspaceId String
  userId      String?
  action      String
  entityType  String
  entityId    String?
  metadata    Json      @default("{}")
  ipAddress   String?
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  @@index([workspaceId, createdAt])
}

model BusinessProfileLocation {
  id                  String             @id @default(uuid())
  socialAccountId     String             @unique
  platformLocationId  String
  locationName        String
  primaryCategory     String?
  address             String?
  phone               String?
  websiteUrl          String?
  description         String?
  regularHours        Json               @default("[]")
  specialHours        Json               @default("[]")
  attributes          Json               @default("{}")
  coverPhotoUrl       String?
  logoPhotoUrl        String?
  photos              Json               @default("[]")
  rating              Float?             @default(0.0)
  reviewCount         Int                @default(0)
  lastSyncedAt        DateTime           @default(now())
  socialAccount       SocialAccount      @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  reviews             CustomerReview[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([platformLocationId])
}

model CustomerReview {
  id                  String                  @id @default(uuid())
  locationId          String
  platformReviewId    String
  reviewerName        String
  reviewerPhotoUrl    String?
  starRating          Int
  comment             String?
  replyText           String?
  replyCreatedAt      DateTime?
  reviewCreatedAt     DateTime                @default(now())
  location            BusinessProfileLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  @@unique([locationId, platformReviewId])
  @@index([locationId, starRating])
}

model RateLimitBucket {
  key       String   @id
  count     Int      @default(1)
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

model Notification {
  id          String           @id @default(uuid())
  workspaceId String
  userId      String?
  type        NotificationType
  title       String
  message     String           @db.Text
  entityType  String?
  entityId    String?
  metadata    Json             @default("{}")
  isRead      Boolean          @default(false)
  createdAt   DateTime         @default(now())

  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User?            @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId, isRead, createdAt])
  @@index([userId, isRead])
}

model OAuthState {
  id          String         @id @default(uuid())
  stateToken  String         @unique
  workspaceId String
  userId      String
  platform    SocialPlatform
  redirectUri String
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime       @default(now())

  @@index([expiresAt])
  @@index([workspaceId])
}

model Subscription {
  id                     String             @id @default(uuid())
  userId                 String
  planId                 String
  source                 SubscriptionSource @default(FREE)
  billingInterval        BillingInterval    @default(NONE)
  status                 SubscriptionStatus @default(ACTIVE)
  razorpayCustomerId     String?
  razorpaySubscriptionId String?            @unique
  razorpayPlanId         String?
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  cancelledAt            DateTime?
  endedAt                DateTime?
  isIndefinite           Boolean            @default(false)
  complimentaryReason    String?            @db.Text
  grantedByAdminId       String?
  metadata               Json               @default("{}")
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  user                   User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                   SubscriptionPlan     @relation(fields: [planId], references: [id])
  transactions           PaymentTransaction[]

  @@index([userId, status])
  @@index([status, currentPeriodEnd])
}

model PaymentTransaction {
  id                     String          @id @default(uuid())
  userId                 String
  subscriptionId         String?
  planCode               String
  billingInterval        BillingInterval @default(MONTHLY)
  amountPaise            Int
  currency               String          @default("INR")
  status                 PaymentStatus   @default(PENDING)
  razorpayOrderId        String?
  razorpayPaymentId      String?         @unique
  razorpaySubscriptionId String?
  razorpayInvoiceId      String?
  invoiceNumber          String?
  failureReason          String?
  refundAmountPaise      Int?
  paidAt                 DateTime?
  metadata               Json            @default("{}")
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  user                   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription           Subscription?   @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model WebhookEvent {
  id          String   @id @default(uuid())
  provider    String   @default("razorpay")
  eventId     String   @unique
  eventType   String
  payloadHash String
  processedAt DateTime @default(now())

  @@index([provider, eventType])
}

model AdminAuditLog {
  id            String   @id @default(uuid())
  adminUserId   String
  adminEmail    String
  targetUserId  String?
  targetEmail   String?
  action        String
  entityType    String
  entityId      String?
  previousValue Json?
  newValue      Json?
  reason        String?  @db.Text
  ipAddress     String?
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([adminUserId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([action])
}

model PlatformSetting {
  key             String   @id
  value           Json
  description     String?
  updatedByUserId String?
  updatedAt       DateTime @updatedAt
}

model WorkspaceInvitation {
  id              String           @id @default(uuid())
  workspaceId     String
  email           String
  role            WorkspaceRole    @default(MEMBER)
  tokenHash       String           @unique
  status          InvitationStatus @default(PENDING)
  invitedByUserId String
  expiresAt       DateTime
  acceptedAt      DateTime?
  rejectedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedByUser   User             @relation("SentWorkspaceInvitations", fields: [invitedByUserId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([email, status])
  @@index([expiresAt])
}

